# ── Server ──
DATABASE_URL=postgresql+asyncpg://postgres:attend@localhost:5432/attendance_db
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
SECRET_KEY=dev-insecure-key-change-me-in-production-at-least-64-chars-long!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Reader devices (comma-separated API keys) ──
READER_API_KEYS=reader-key-room-101,reader-key-room-202

# ── Session defaults ──
DEFAULT_FRESHNESS_DELTA_SEC=120
DEFAULT_MIN_PRESENCE_PCT=75
